# Example Nginx server block for SRMS production.
# Configure TLS, PHP-FPM socket and hostname for your environment.
server {
    listen 80;
    server_name srms.example.edu;
    root /var/www/srms;
    index index.php index.html;

    client_max_body_size 50m;

    location / {
        try_files $uri $uri/ /index.php?$query_string;
    }

    location ~ \.php$ {
        include snippets/fastcgi-php.conf;
        fastcgi_pass unix:/run/php/php-fpm.sock;
    }

    location ~* \.(?:sql|log|ini|md)$ { deny all; }
    location ~* ^/(?:tests|deploy|uploads)(?:/|$) { deny all; }
}
