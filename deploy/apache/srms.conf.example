# Example Apache VirtualHost for SRMS production.
# Adjust paths, hostname, PHP-FPM socket and TLS configuration for your server.
<VirtualHost *:80>
    ServerName srms.example.edu
    DocumentRoot /var/www/srms

    <Directory /var/www/srms>
        AllowOverride All
        Options -Indexes
        Require all granted
    </Directory>

    ErrorLog ${APACHE_LOG_DIR}/srms-error.log
    CustomLog ${APACHE_LOG_DIR}/srms-access.log combined

    # Redirect HTTP to HTTPS after TLS is configured.
    RewriteEngine On
    RewriteCond %{HTTPS} !=on
    RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [R=301,L]
</VirtualHost>
